DB_HOST=localhost
DB_PORT=5432
DB_NAME=recruitment_db
DB_USER=postgres
DB_PASSWORD=CHANGE_ME
APP_NAME=Recruitment Management System API
APP_VERSION=0.1.0
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://localhost:8501
# JWT settings are required before access-token services can be initialized.
# Mount separate RSA private/public PEM files from a secret manager; do not commit keys.
JWT_ISSUER=https://recruitment.example.invalid
JWT_AUDIENCE=recruitment-management-api
JWT_PRIVATE_KEY_PATH=
JWT_PUBLIC_KEY_PATH=
REFRESH_TOKEN_LIFETIME_DAYS=7
REFRESH_TOKEN_FAMILY_LIFETIME_DAYS=30
